# Copy this file to .env and select the settings for your model server.
# Command-line flags override these values.

# Ollama default. For LM Studio, use http://localhost:1234/v1.
SCAN_BASE_URL=http://localhost:11434/v1

# This must match a model exposed by the server.
SCAN_MODEL=llama3.1

# Most local servers ignore the key but the OpenAI SDK requires a value.
SCAN_API_KEY=not-needed

# Per-request timeout in seconds.
SCAN_TIMEOUT=120

# Caps response generation. Lower values are faster but may truncate large reports.
SCAN_MAX_TOKENS=1024

# Limit report length. Lower this for faster CPU-only inference.
SCAN_MAX_FINDINGS=10

# auto: schema first, fallback on explicit unsupported-format errors
# required: never downgrade; off: legacy prompt-only JSON
SCAN_STRUCTURED_OUTPUT=auto
